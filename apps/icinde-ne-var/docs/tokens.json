  "typography": {
    "family": {
      "display": "PlusJakartaSans",
      "body": "PlusJakartaSans"
    },
    "expo": "@expo-google-fonts/plus-jakarta-sans",
    "styles": {
      "display": { "size": 32, "weight": "800", "lineHeight": 38, "letterSpacing": -0.5 },
      "title": { "size": 22, "weight": "700", "lineHeight": 28, "letterSpacing": -0.3 },
      "body": { "size": 16, "weight": "400", "lineHeight": 24, "letterSpacing": 0 },
      "caption": { "size": 13, "weight": "500", "lineHeight": 18, "letterSpacing": 0 },
      "label": { "size": 14, "weight": "600", "lineHeight": 20, "letterSpacing": 0.1 }
    }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "2xl": 48
  },
  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 20,
    "xl": 28,
    "full": 9999
  },
  "shadow": {
    "sm": {
      "ios": { "shadowColor": "#000", "shadowOffset": { "width": 0, "height": 1 }, "shadowOpacity": 0.05, "shadowRadius": 2 },
      "android": { "elevation": 1 }
    },
    "card": {
      "ios": { "shadowColor": "#000", "shadowOffset": { "width": 0, "height": 2 }, "shadowOpacity": 0.08, "shadowRadius": 8 },
      "android": { "elevation": 3 }
    },
    "sheet": {
      "ios": { "shadowColor": "#000", "shadowOffset": { "width": 0, "height": -4 }, "shadowOpacity": 0.12, "shadowRadius": 24 },
      "android": { "elevation": 8 }
    }
  }
